{% if site.description != "" or theme.tokens.show_search %}
  <header class="journal-head">
    {% if site.description != "" %}<p>{{ site.description | escape }}</p>{% endif %}
    {% if theme.tokens.show_search %}
      <form action="/search" method="get" class="search-form" role="search">
        <input type="search" name="q" value="{{ search_query | escape }}" placeholder="Search the journal&hellip;" aria-label="Search posts" />
      </form>
    {% endif %}
  </header>
{% endif %}

{% if search_query %}
  <p class="search-summary">{{ search_count }} stor{% if search_count == 1 %}y{% else %}ies{% endif %} for &ldquo;{{ search_query | escape }}&rdquo;</p>
{% endif %}

{% if theme.tokens.show_tags and tags != empty %}
  <nav class="tag-filter" aria-label="Filter posts by tag">
    <a href="/"{% unless current_tag %} class="is-active"{% endunless %}>All</a>
    {% for tag in tags %}
      <a href="?tag={{ tag.slug }}"{% if tag.active %} class="is-active"{% endif %}>{{ tag.name | escape }}</a>
    {% endfor %}
  </nav>
{% endif %}

{% if posts == empty %}
  <p class="empty">{% if search_query %}Nothing in the journal matches that.{% else %}No stories yet.{% endif %}</p>
{% else %}
  <ul class="cards">
    {% for post in posts %}
      <li class="card{% if post.post_options.featured_image == '' %} card-noimage{% endif %}">
        <a href="{{ post.url }}">
          {% if post.post_options.featured_image != "" %}
            <figure class="card-media"><img src="{{ post.post_options.featured_image }}" alt="{{ post.post_options.featured_alt | escape }}" loading="lazy" /></figure>
          {% endif %}
          {% if post.tags != empty %}
            <p class="kicker">{% for tag in post.tags %}{{ tag.name | escape }}{% unless forloop.last %}, {% endunless %}{% endfor %}</p>
          {% endif %}
          <h2 class="display card-title">{{ post.title | escape }}</h2>
          {% if post.excerpt and post.excerpt != "" %}<p class="card-excerpt">{{ post.excerpt | escape }}</p>{% endif %}
        </a>
      </li>
    {% endfor %}
  </ul>
{% endif %}
