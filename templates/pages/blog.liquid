{% if page.page_options.show_title or page.page_options.intro != "" %}
  <header class="journal-head">
    {% if page.page_options.show_title %}<h1 class="display">{{ page.title | escape }}</h1>{% endif %}
    {% if page.page_options.intro != "" %}<p>{{ page.page_options.intro | escape }}</p>{% endif %}
  </header>
{% endif %}

{% if page.page_options.show_tags and tags != empty %}
  <nav class="tag-filter" aria-label="Filter posts by tag">
    <a href="{{ page.url }}"{% unless current_tag %} class="is-active"{% endunless %}>All</a>
    {% for tag in tags %}
      <a href="?tag={{ tag.slug }}"{% if tag.active %} class="is-active"{% endif %}>{{ tag.name | escape }}</a>
    {% endfor %}
  </nav>
{% endif %}

{% if posts == empty %}
  <p class="empty">No stories yet.</p>
{% else %}
  <ul class="cards">
    {% for post in posts %}
      <li class="card{% if post.post_options.featured_image == '' %} card-noimage{% endif %}">
        <a href="{{ post.url }}">
          {% if post.post_options.featured_image != "" %}
            <figure class="card-media"><img src="{{ post.post_options.featured_image }}" alt="{{ post.post_options.featured_alt | escape }}" loading="lazy" /></figure>
          {% endif %}
          {% if post.tags != empty %}
            <p class="kicker">{% for tag in post.tags %}{{ tag.name | escape }}{% unless forloop.last %}, {% endunless %}{% endfor %}</p>
          {% endif %}
          <h2 class="display card-title">{{ post.title | escape }}</h2>
          {% if post.excerpt and post.excerpt != "" %}<p class="card-excerpt">{{ post.excerpt | escape }}</p>{% endif %}
        </a>
      </li>
    {% endfor %}
  </ul>
{% endif %}
