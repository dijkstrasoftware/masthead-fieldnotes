<article class="post">
  <header class="post-head">
    {% if post.tags != empty %}
      <p class="kicker">{% for tag in post.tags %}<a href="/?tag={{ tag.slug }}">{{ tag.name | escape }}</a>{% unless forloop.last %}, {% endunless %}{% endfor %}</p>
    {% endif %}
    <h1 class="display">{{ post.title | escape }}</h1>
    {% if post.excerpt and post.excerpt != "" %}<p class="dek">{{ post.excerpt | escape }}</p>{% endif %}
    {% if post.published_at %}
      <p class="byline"><time datetime="{{ post.published_at | iso8601 }}">{{ post.published_at | strftime: "%B %-d, %Y" }}</time></p>
    {% endif %}
  </header>

  {% assign layout = post.post_options.featured_layout | default: "wide" %}
  {% if post.post_options.featured_image != "" and layout != "hidden" %}
    <figure class="feature feature-{{ layout }}">
      <img src="{{ post.post_options.featured_image }}" alt="{{ post.post_options.featured_alt | escape }}" />
      {% if post.post_options.featured_caption != "" %}<figcaption>{{ post.post_options.featured_caption | escape }}</figcaption>{% endif %}
    </figure>
  {% endif %}

  <div class="post-body{% if theme.tokens.drop_cap %} drop-cap{% endif %}">
    {{ body_html }}
  </div>

  <footer class="post-foot">
    <a href="/">&larr; The journal</a>
    {% if post.tags != empty %}
      <span class="post-tags">{% for tag in post.tags %}<a href="/?tag={{ tag.slug }}">{{ tag.name | escape }}</a>{% endfor %}</span>
    {% endif %}
  </footer>
</article>

{% if theme.tokens.show_more %}
  {% assign first_tag = post.tags | first %}
  {% assign more = posts %}
  {% if first_tag %}
    {% assign tagged = posts_by_tag[first_tag.slug] %}
    {% if tagged.size > 1 %}{% assign more = tagged %}{% endif %}
  {% endif %}
  {% if more.size > 1 %}
    <section class="more" aria-label="More stories">
      <h2>{% if more == tagged %}More in {{ first_tag.name | escape }}{% else %}More from the journal{% endif %}</h2>
      <ul class="cards">
        {% assign shown = 0 %}
        {% for p in more %}
          {% if p.slug != post.slug and shown < 3 %}
            {% assign shown = shown | plus: 1 %}
            <li class="card{% if p.post_options.featured_image == '' %} card-noimage{% endif %}">
              <a href="{{ p.url }}">
                {% if p.post_options.featured_image != "" %}
                  <figure class="card-media"><img src="{{ p.post_options.featured_image }}" alt="{{ p.post_options.featured_alt | escape }}" loading="lazy" /></figure>
                {% endif %}
                {% if p.tags != empty %}
                  <p class="kicker">{% for tag in p.tags %}{{ tag.name | escape }}{% unless forloop.last %}, {% endunless %}{% endfor %}</p>
                {% endif %}
                <h3 class="display card-title">{{ p.title | escape }}</h3>
              </a>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </section>
  {% endif %}
{% endif %}
